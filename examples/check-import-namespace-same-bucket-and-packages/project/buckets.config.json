{
  "$schema": "https://nicolascaous.github.io/slopbuckets/schema/v2.json",
  "version": "2.0",
  "buckets": {
    "app": {
      "purpose": "Starts the program and wires each part",
      "files": [
        "src/app/**"
      ],
      "public": null,
      "dependsOn": {
        "billing": "Charges orders at startup"
      },
      "packages": {
        "node:path": "Joins the paths of the files it reads"
      }
    },
    "billing": {
      "purpose": "Issues and charges invoices",
      "files": [
        "src/billing/**"
      ],
      "public": "src/billing/index.ts",
      "dependsOn": {},
      "packages": {}
    }
  }
}
