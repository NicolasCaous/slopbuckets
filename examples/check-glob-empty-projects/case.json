{
  "description": "a projects folder without buckets.config.json gives glob-empty",
  "expect": {
    "exitCode": 1,
    "violations": [
      {
        "rule": "glob-empty",
        "file": "buckets.config.json"
      }
    ],
    "stdoutJson": {
      "violations": [
        {
          "rule": "glob-empty",
          "field": "projects",
          "bucket": null,
          "glob": "packages/sdk"
        }
      ]
    }
  }
}
