{
  "description": "public pointing to a file of another bucket gives public-missing",
  "expect": {
    "exitCode": 1,
    "violations": [
      {
        "rule": "public-missing",
        "file": "src/payments/index.ts"
      }
    ],
    "stdoutJson": {
      "violations": [
        {
          "rule": "public-missing",
          "state": "other-bucket",
          "owner": "payments"
        }
      ]
    }
  }
}
