    "stdoutJson": {
      "violations": [
        { "rule": "dependency-undeclared", "from": "app", "to": "billing", "reversePath": null, "reverseUndeclared": true },
        { "rule": "dependency-undeclared", "from": "billing", "to": "app", "reversePath": null, "reverseUndeclared": true }
      ]
    }
  }
}
