{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@root/*": [
        "root/*"
      ],
      "log-internals": [
        "root/log/_/logger.ts"
      ]
    }
  },
  "include": [
    "root"
  ]
}
