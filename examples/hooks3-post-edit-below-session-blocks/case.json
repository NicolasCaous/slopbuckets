{
  "description": "PostToolUse checks an edited file in the project nearest to it when the session was opened above it",
  "lock": "fresh",
  "delete": [],
  "args": [
    "hook",
    "post-tool-use"
  ],
  "claudeProjectDir": "parent",
  "stdin": {
    "transcript_path": "/home/dev/.claude/projects/example/session.jsonl",
    "cwd": "${PROJECT}/..",
    "permission_mode": "bypassPermissions",
    "hook_event_name": "PostToolUse",
    "tool_name": "Edit",
    "tool_input": {
      "file_path": "${PROJECT}/root/log/_/logger.ts",
      "old_string": "import { formatLine } from '@root/log/_/format';",
      "new_string": "import { formatLine } from './format';",
      "replace_all": false
    },
    "tool_response": {
      "filePath": "${PROJECT}/root/log/_/logger.ts",
      "success": true
    }
  },
  "expect": {
    "exitCode": 0,
    "stdoutJson": {
      "decision": "block"
    }
  }
}
