{
  "description": "PreToolUse denies a Bash command that names a lock when its cwd is above every project",
  "lock": "none",
  "delete": [],
  "args": [
    "hook",
    "pre-tool-use"
  ],
  "claudeProjectDir": "parent",
  "stdin": {
    "transcript_path": "/home/dev/.claude/projects/example/session.jsonl",
    "cwd": "${PROJECT}/..",
    "permission_mode": "bypassPermissions",
    "hook_event_name": "PreToolUse",
    "tool_name": "Bash",
    "tool_input": {
      "command": "cat */buckets.lock.json",
      "description": "Show the locks"
    }
  },
  "expect": {
    "exitCode": 0,
    "stdoutJson": {
      "hookSpecificOutput": {
        "hookEventName": "PreToolUse",
        "permissionDecision": "deny"
      }
    }
  }
}
