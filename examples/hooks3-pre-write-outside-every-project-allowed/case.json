    "hook_event_name": "PreToolUse",
    "tool_name": "Write",
    "tool_input": {
      "file_path": "${PROJECT}/../hooks3-scratch/buckets.lock.json",
      "content": "{}\n"
    }
  },
  "expect": {
    "exitCode": 0,
    "stdoutEmpty": true
  }
