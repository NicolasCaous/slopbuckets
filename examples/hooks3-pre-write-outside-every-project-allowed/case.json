{
  "description": "PreToolUse allows a file named like the lock when no project holds it",
  "lock": "none",
  "delete": [],
  "args": [
    "hook",
    "pre-tool-use"
  ],
  "claudeProjectDir": "parent",
  "stdin": {
    "transcript_path": "/home/dev/.claude/projects/example/session.jsonl",
    "cwd": "${PROJECT}/..",
