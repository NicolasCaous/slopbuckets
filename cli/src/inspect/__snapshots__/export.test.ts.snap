// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`bucket graph as Mermaid > matches the snapshot of the fixture 1`] = `
"flowchart TB
  %% Bucket graph of @acme/shop "x", from buckets inspect --export mermaid
  %% Edges are DMZ files from provider to consumer, labeled with the number of symbols.
  subgraph P0["@acme/shop #quot;x#quot; (repo)"]
    subgraph P0_B0["root/"]
      P0_B0_c["_/ 1 file"]
      subgraph P0_B1["billing/"]
        P0_B1_c["_/ 1 file"]
        P0_B1_d{{"dmz/ .parent"}}
        subgraph P0_B2["invoices/"]
          P0_B2_c["_/ 2 files"]
        end
        subgraph P0_B3["payments/"]
          P0_B3_c["_/ 2 files"]
        end
      end
      subgraph P0_B4["log/"]
        P0_B4_c["_/ 1 file"]
        subgraph P1["engine (root/log/_/engine)"]
          subgraph P1_B0["root/"]
            P1_B0_c["_/ 1 file"]
            P1_B0_x0(["core/.external"])
            subgraph P1_B1["core/"]
              P1_B1_c["_/ 1 file"]
            end
          end
        end
      end
      subgraph P0_B5["web/"]
        P0_B5_c["_/ 1 file"]
      end
    end
  end
  P0_B1_d -->|"1 symbol"| P0_B2_c
  P0_B2_c -->|"1 symbol"| P0_B3_c
  P0_B3_c -->|"1 symbol"| P0_B2_c
  P0_B4_c -->|"1 symbol"| P0_B1_c
  P0_B4_c -->|"1 symbol"| P0_B5_c
  P1_B1_c -->|"1 symbol"| P1_B0_x0
  P0_B5_c -.->|"link engine"| P1_B0_x0
  P0_B2_c ==>|"cycle"| P0_B3_c
  P0_B3_c ==>|"cycle"| P0_B2_c
  classDef ok fill:#021a0a,stroke:#3dff74,color:#b4f5c6
  classDef lock fill:#1c1404,stroke:#ffc04d,color:#ffe6b8
  classDef violation fill:#1a0402,stroke:#ff6e61,color:#ffd3cd
  classDef dmz fill:#010603,stroke:#8ef9ff,color:#8ef9ff
  classDef origin fill:#010603,stroke:#2b8a4c,color:#6cbf86,stroke-dasharray:4 4
  class P0_B0_c,P0_B2_c,P0_B3_c violation
  class P0_B1_c lock
  class P0_B1_d dmz
  class P0_B4_c,P1_B0_c,P1_B0_x0,P1_B1_c,P0_B5_c ok
  style P0 fill:#020904,stroke:#ff6e61,color:#ff6e61
  style P0_B0 fill:#010603,stroke:#ff6e61,color:#ffd3cd
  style P0_B1 fill:#010603,stroke:#ffc04d,color:#ffe6b8
  style P0_B2 fill:#010603,stroke:#ff6e61,color:#ffd3cd
  style P0_B3 fill:#010603,stroke:#ff6e61,color:#ffd3cd
  style P0_B4 fill:#010603,stroke:#3dff74,color:#b4f5c6
  style P0_B5 fill:#010603,stroke:#3dff74,color:#b4f5c6
  style P1 fill:#020904,stroke:#3dff74,color:#3dff74
  style P1_B0 fill:#010603,stroke:#3dff74,color:#b4f5c6
  style P1_B1 fill:#010603,stroke:#3dff74,color:#b4f5c6
  linkStyle 0,1,2,3 stroke:#ffc04d,stroke-width:2.5px
  linkStyle 4 stroke:#ff6e61,stroke-width:2.5px
  linkStyle 5,6 stroke:#3dff74,stroke-width:1.5px
  linkStyle 7,8 stroke:#ff6e61,stroke-width:3px
"
`;

