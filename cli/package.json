{
  "name": "slopbuckets",
  "version": "2.0.0",
  "description": "AI agents keep the architecture of a project in buckets.config.json, and hooks warn them when the code drifts from it.",
  "license": "MIT",
  "author": "Nicolas Caous",
  "type": "module",
  "bin": {
    "buckets": "dist/index.js"
  },
  "files": [
    "dist",
    "skill"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NicolasCaous/slopbuckets.git",
    "directory": "cli"
  },
  "homepage": "https://nicolascaous.github.io/slopbuckets/",
  "bugs": {
    "url": "https://github.com/NicolasCaous/slopbuckets/issues"
  },
  "keywords": [
    "ai",
    "ai-agents",
    "agents-md",
    "architecture",
    "boundaries",
    "claude-code",
    "dependency-rules",
    "hooks",
    "imports",
    "lint",
    "modules",
    "monorepo",
    "typescript"
  ],
  "scripts": {
    "build": "tsup && node scripts/build-inspect.mjs",
    "typecheck": "tsc --noEmit",
    "prepack": "node scripts/prepack.mjs"
  },
  "dependencies": {
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@slopbuckets/adapter-ts": "*"
  },
  "publishConfig": {
    "access": "public"
  }
}
